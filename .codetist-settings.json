{
  "editor.minimap.enabled": true,
  "editor.minimap.side": "right",
  "editor.lineNumbers": true,
  "editor.lineNumbers.mode": "normal",
  "appearance-fontFamily": "monospace",
  "appearance-fontSize": "13",
  "appearance-fontLigatures": true,
  "appearance-cursorStyle": "line",
  "appearance-cursorBlink": true,
  "appearance-terminalFontSize": "13",
  "appearance-showStatusBar": true,
  "editor.lineHeight": "1.6",
  "appearance-tabSize": "2",
  "editor.indentOnInput": true,
  "appearance-wordWrap": false,
  "editor.wordWrap.column": "viewport",
  "editor.closeBrackets": true,
  "editor.bracketMatching": true,
  "editor.highlightActiveLine": true,
  "editor.highlightActiveLineGutter": true,
  "editor.foldGutter": true,
  "editor.highlightSelectionMatches": true,
  "lsp-dart": "enabled",
  "lsp-ts": "enabled",
  "lsp-tsx": "enabled",
  "lsp-js": "enabled",
  "lsp-jsx": "enabled",
  "lsp-py": "enabled",
  "lsp-rs": "enabled",
  "lsp-go": "enabled",
  "lsp-c": "enabled",
  "lsp-cpp": "enabled",
  "lsp-h": "enabled",
  "lsp-hpp": "enabled",
  "lsp-php": "enabled",
  "lsp-rb": "enabled",
  "lsp-java": "enabled",
  "lsp-kt": "enabled",
  "lsp-swift": "enabled",
  "lsp-cs": "enabled",
  "lsp-html": "enabled",
  "lsp-css": "enabled",
  "lsp-json": "enabled",
  "lsp-sh": "enabled",
  "lsp-sql": "enabled",
  "lsp-yaml": "enabled",
  "lsp-vue": "enabled",
  "lsp-svelte": "enabled",
  "lsp-zig": "enabled",
  "lsp-lua": "enabled",
  "lsp-ex": "enabled",
  "codemirror-autocomplete": "enabled",
  "codemirror-lintgutter": "enabled",
  "codemirror-closebrackets": "enabled",
  "codemirror-indentOnInput": "enabled",
  "agent-parallel-execution": false,
  "agent-sandbox-commands": false,
  "agent-notifications": false,
  "agent-max-iterations": "12",
  "agent-command-approval": "excluded",
  "agent-auto-accept-edits": false,
  "agent-web-access": true,
  "agent-browser-preview": true,
  "agent-custom-instructions": "",
  "agent-excluded-commands": [
    "rm",
    "npm install",
    "git push"
  ]
}
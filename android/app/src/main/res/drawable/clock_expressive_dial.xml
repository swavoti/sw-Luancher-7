<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="200dp"
    android:height="200dp"
    android:viewportWidth="200"
    android:viewportHeight="200">

    <!-- Clean outlined clock ring (transparent interior) -->
    <path
        android:fillColor="@android:color/transparent"
        android:pathData="M100,10 A90,90 0 1,1 99.9,10 Z"
        android:strokeWidth="4.5"
        android:strokeColor="@color/widget_on_surface" />

    <!-- 12, 3, 6, 9 o'clock clean tick marks -->
    <path
        android:pathData="M100,20 L100,32"
        android:strokeWidth="4"
        android:strokeColor="@color/widget_accent"
        android:strokeLineCap="round" />
    <path
        android:pathData="M180,100 L168,100"
        android:strokeWidth="3.5"
        android:strokeColor="@color/widget_on_surface_muted"
        android:strokeLineCap="round" />
    <path
        android:pathData="M100,180 L100,168"
        android:strokeWidth="3.5"
        android:strokeColor="@color/widget_on_surface_muted"
        android:strokeLineCap="round" />
    <path
        android:pathData="M20,100 L32,100"
        android:strokeWidth="3.5"
        android:strokeColor="@color/widget_on_surface_muted"
        android:strokeLineCap="round" />
</vector>

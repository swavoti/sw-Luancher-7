<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Wallpaper theme is opaque to WindowManager (unlike Theme.Translucent).
         Android 10 QuickStep aborts the home gesture if the launcher window
         is marked translucent — the previous app then snaps back open. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Wallpaper.NoTitleBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
    </style>

    <style name="NormalTheme" parent="@android:style/Theme.Wallpaper.NoTitleBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
    </style>
</resources>

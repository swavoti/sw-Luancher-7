{
  "name": "Warm Paper",
  "type": "light",
  "colors": {
    "editor.background": "#fffefa",
    "editor.foreground": "#292722",
    "editorLineNumber.foreground": "#b8b2a8",
    "editorLineNumber.activeForeground": "#6f675d",
    "editorCursor.foreground": "#b65d3b",
    "editor.selectionBackground": "#f5e9dd",
    "editor.inactiveSelectionBackground": "#faf2e9",
    "editor.lineHighlightBackground": "#fcf8f2",
    "editorBracketMatch.background": "#e9f2ea",
    "editorBracketMatch.border": "#6d9677",
    "editorWhitespace.foreground": "#eeeae4",
    "editorIndentGuide.background": "#f0ece6",
    "editorIndentGuide.activeBackground": "#d8d0c5",
    "editorGutter.background": "#fffefa",
    "editorWidget.background": "#ffffff",
    "editorWidget.border": "#eee9e2",
    "editorSuggestWidget.background": "#ffffff",
    "editorSuggestWidget.foreground": "#292722",
    "editorSuggestWidget.selectedBackground": "#f7f1e9",
    "editorHoverWidget.background": "#ffffff",
    "editorHoverWidget.border": "#eee9e2",
    "editorError.foreground": "#bd3d36",
    "editorWarning.foreground": "#a66b19",
    "editorInfo.foreground": "#397a9b",
    "editorOverviewRuler.errorForeground": "#c94c43",
    "editorOverviewRuler.warningForeground": "#c58a34",
    "editorOverviewRuler.infoForeground": "#4f8eae",
    "activityBar.background": "#fffdf9",
    "activityBar.foreground": "#514b43",
    "activityBar.border": "#f0ece6",
    "sideBar.background": "#fffdf9",
    "sideBar.foreground": "#39352f",
    "sideBar.border": "#f0ece6",
    "sideBarTitle.foreground": "#514b43",
    "sideBarSectionHeader.background": "#fbf8f3",
    "sideBarSectionHeader.foreground": "#625b52",
    "tab.activeBackground": "#fffefa",
    "tab.activeForeground": "#292722",
    "tab.activeBorderTop": "#b65d3b",
    "tab.inactiveBackground": "#fbf8f3",
    "tab.inactiveForeground": "#79736a",
    "tab.border": "#f0ece6",
    "tab.hoverBackground": "#f7f3ed",
    "editorGroupHeader.tabsBackground": "#fbf8f3",
    "editorGroupHeader.tabsBorder": "#f0ece6",
    "statusBar.background": "#f8f5ef",
    "statusBar.foreground": "#514b43",
    "statusBar.border": "#eee9e2",
    "titleBar.activeBackground": "#fbf8f3",
    "titleBar.activeForeground": "#39352f",
    "titleBar.border": "#f0ece6",
    "panel.background": "#fdfbf8",
    "panel.border": "#f0ece6",
    "input.background": "#ffffff",
    "input.foreground": "#292722",
    "input.border": "#e9e3da",
    "input.placeholderForeground": "#928a80",
    "button.background": "#a95335",
    "button.foreground": "#ffffff",
    "button.hoverBackground": "#91462e",
    "focusBorder": "#a95335",
    "list.activeSelectionBackground": "#f5e9dd",
    "list.activeSelectionForeground": "#292722",
    "list.hoverBackground": "#faf6f0",
    "list.focusOutline": "#a95335",
    "terminal.background": "#fffefa",
    "terminal.foreground": "#292722",
    "terminal.cursor": "#a95335",
    "terminal.selectionBackground": "#f2e7db",
    "terminal.ansiBlack": "#39352f",
    "terminal.ansiRed": "#b84a42",
    "terminal.ansiGreen": "#557c54",
    "terminal.ansiYellow": "#9b701d",
    "terminal.ansiBlue": "#47748f",
    "terminal.ansiMagenta": "#93617f",
    "terminal.ansiCyan": "#477f7a",
    "terminal.ansiWhite": "#f0ece6",
    "terminal.ansiBrightBlack": "#827566",
    "terminal.ansiBrightRed": "#cb5c51",
    "terminal.ansiBrightGreen": "#6c9363",
    "terminal.ansiBrightYellow": "#b78b34",
    "terminal.ansiBrightBlue": "#5b8ca9",
    "terminal.ansiBrightMagenta": "#aa7895",
    "terminal.ansiBrightCyan": "#5a9891",
    "terminal.ansiBrightWhite": "#ffffff"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#858078", "fontStyle": "italic" }
    },
    {
      "name": "Strings",
      "scope": ["string", "string.quoted", "string.template"],
      "settings": { "foreground": "#34734a" }
    },
    {
      "name": "Keywords",
      "scope": ["keyword", "storage", "storage.type", "storage.modifier"],
      "settings": { "foreground": "#a1432d" }
    },
    {
      "name": "Functions",
      "scope": ["entity.name.function", "support.function", "meta.function-call"],
      "settings": { "foreground": "#875b1c" }
    },
    {
      "name": "Types and Classes",
      "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"],
      "settings": { "foreground": "#326887" }
    },
    {
      "name": "Variables and Properties",
      "scope": ["variable", "variable.other", "variable.parameter", "meta.object-literal.key"],
      "settings": { "foreground": "#39352f" }
    },
    {
      "name": "Numbers and Constants",
      "scope": ["constant.numeric", "constant.language", "constant"],
      "settings": { "foreground": "#875078" }
    },
    {
      "name": "Operators and Punctuation",
      "scope": ["keyword.operator", "punctuation", "meta.brace"],
      "settings": { "foreground": "#645d53" }
    },
    {
      "name": "Tags and Attributes",
      "scope": ["entity.name.tag", "entity.other.attribute-name"],
      "settings": { "foreground": "#a1432d" }
    }
  ]
}
